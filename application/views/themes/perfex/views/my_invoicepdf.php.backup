// Render items
$item_number = 1;
foreach ($invoice->items as $item) {
    $item_total = (float)$item->qty * (float)$item->rate;
    
    // Get tax info
    $tax_name = '';
    $tax_rate = 0;
    if (!empty($item->taxname)) {
        $tax_parts = explode('|', $item->taxname);
        if (count($tax_parts) > 0) {
            $tax_name = $tax_parts[0];
        }
    }
    if (!empty($item->taxrate)) {
        $tax_rate = (float)$item->taxrate;
    }
    $tax_display = $tax_name ? $tax_name . ' ' . number_format($tax_rate, 2) . '%' : '';
    
    // Parse long description for bullet points
    $description_html = '';
    if (!empty($item->long_description)) {
        $long_desc = trim($item->long_description);
        
        // Split by lines
        $lines = preg_split('/\r\n|\r|\n/', $long_desc);
        $bullet_items = [];
        
        foreach ($lines as $line) {
            $line = trim($line);
            if (empty($line)) continue;
            
            // Remove bullet indicators and add to list
            $line = preg_replace('/^[\*\-\•]\s*/', '', $line);
            if (!empty($line)) {
                $bullet_items[] = $line;
            }
        }
        
        if (count($bullet_items) > 0) {
            foreach ($bullet_items as $bullet) {
                $description_html .= htmlspecialchars($bullet) . '<br>';
            }
        }
    }
    
    $html .= '
        <table style="width: 100%; border-collapse: collapse; border-bottom: 1px solid #e8e8e8;">
            <tr>
                <td style="width: 5%; padding: 15px 10px; font-size: 10px; color: #2d3748; text-align: center; vertical-align: top;">' . $item_number . '</td>
                <td style="width: 40%; padding: 15px 10px; vertical-align: top;">
                    <div style="font-size: 10px; color: #1a202c; font-weight: 700; margin-bottom: 4px;">' . htmlspecialchars($item->description) . '</div>
                    <div style="font-size: 9px; color: #718096; line-height: 1.6;">' . $description_html . '</div>
                </td>
                <td style="width: 10%; padding: 15px 10px; font-size: 10px; color: #2d3748; text-align: center; vertical-align: top;">' . htmlspecialchars($item->qty) . '</td>
                <td style="width: 15%; padding: 15px 10px; font-size: 10px; color: #2d3748; text-align: center; vertical-align: top;">' . number_format((float)$item->rate, 2) . '</td>
                <td style="width: 15%; padding: 15px 10px; font-size: 9px; color: #2d3748; text-align: center; vertical-align: top;">' . htmlspecialchars($tax_display) . '</td>
                <td style="width: 15%; padding: 15px 10px; font-size: 11px; color: #1a202c; font-weight: 700; text-align: right; vertical-align: top;">' . number_format($item_total, 2) . '</td>
            </tr>
        </table>';
    
    $item_number++;
}

$html .= '
